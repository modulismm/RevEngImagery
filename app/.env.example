# Name of the first administrator account, created on first run only.
IMAGERY_ADMIN=bear

# Leave EMPTY to have the container log a one-time /setup/<token> link instead.
# That is preferable: the passphrase then never sits in a file on disk.
IMAGERY_ADMIN_PASSPHRASE=

# Cookies are Secure by default. Set to 0 only for plain-HTTP local testing.
IMAGERY_SECURE_COOKIE=1

# Which interface the container publishes on. NEVER 0.0.0.0.
#   172.17.0.1 = docker0 gateway, for nginx-proxy-manager (default)
#   127.0.0.1  = localhost only, when `tailscale serve` sits in front
IMAGERY_BIND=172.17.0.1
IMAGERY_PORT=8010

# --- production only (docker-compose.prod.yml) ---------------------------
# The hostname this is served on. Caddy gets a certificate for it
# automatically, which is required: without HTTPS the browser will not allow
# microphone recording at all.
IMAGERY_DOMAIN=imagery.example.org
# Optional: where Let's Encrypt sends expiry warnings.
IMAGERY_TLS_EMAIL=
